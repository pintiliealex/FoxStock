{
  "rewrites": [
    {
      "source": "/api-yahoo/:path*",
      "destination": "https://query1.finance.yahoo.com/:path*"
    },
    {
      "source": "/etoro-api/:path*",
      "destination": "https://public-api.etoro.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
